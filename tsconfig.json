{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite handles transpilation, tsc is used only for type-checking) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias: `@/x` always resolves to `src/x`, used in every feature/shared import
       instead of fragile relative chains like `../../../shared/lib/apiClient`.
       No `baseUrl` on purpose: `paths` resolves relative to this file, and `baseUrl` is deprecated
       in TypeScript 6 / removed in 7. Keep in sync with the alias in vite.config.ts. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Strictness — this is the mechanism that guarantees the codebase has no unused
       imports/locals/params and no implicit-any leaks. Run `npm run typecheck` to enforce it. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
