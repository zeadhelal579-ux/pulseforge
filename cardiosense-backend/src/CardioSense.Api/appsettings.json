{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "CardioSense",
    "Audience": "CardioSense.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 10
  },
  "Mqtt": {
    "Enabled": true,
    "BrokerHost": "localhost",
    "BrokerPort": 8883,
    "UseTls": true,
    "ClientId": "cardiosense-ingestion",
    "ReconnectDelaySeconds": 5
  },
  "Monitoring": {
    "DoctorPatientCapacity": 50,
    "DeviceLiveWindowSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RefreshCookie": {
    "Name": "cardiosense_refresh",
    "Path": "/api/auth",
    "SameSite": "Strict"
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Database": {
    "Initialization": "None"
  }
}
