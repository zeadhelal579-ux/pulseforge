# Copy to .env (never commit .env) and fill in. docker compose refuses to start while a required value is missing.

# SQL Server 'sa' password: at least 8 characters with upper-case, lower-case, digits and a symbol.
SQLSERVER_SA_PASSWORD=

# Signs access tokens: at least 32 random characters (for example: openssl rand -base64 48).
JWT_SIGNING_KEY=

# Shared MQTT user that the API and the devices connect with (a single user is a prototype shortcut).
MQTT_USERNAME=cardiosense
MQTT_PASSWORD=

# Browser origin of the web client (exactly as the browser shows it, no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
