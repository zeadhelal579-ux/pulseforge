# Copy this file to .env and fill in real values for local development.
# Never commit a real .env — only this .env.example with placeholders.

# Base URL of the ASP.NET Core Web API (see backend-database-architecture.md §5)
VITE_API_BASE_URL=https://localhost:5001/api

# SignalR hub URL (see backend-database-architecture.md §5 "SignalR hub")
VITE_SIGNALR_HUB_URL=https://localhost:5001/hubs/monitoring

# Default UI language when no session/browser preference is available: "ar" | "en"
VITE_DEFAULT_LANGUAGE=ar
