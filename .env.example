# Copy this file to .env.local for local development. Real .env files are git-ignored:
# never commit one, only this .env.example with placeholders.
#
# MODES
#   Demo mode (default)  Nothing below is set. A built-in, browser-only backend answers every request,
#                        so the whole app (login, both dashboards, live ECG) works with no server.
#                        This is what a fresh Vercel deployment runs.
#   Live mode            Set VITE_API_BASE_URL. The app then talks to the real ASP.NET Core API + SignalR hub.
#
#   Rule: demo mode is ON unless VITE_API_BASE_URL is set or VITE_DEMO_MODE=false.
#   Force it either way with VITE_DEMO_MODE=true | false.

# VITE_DEMO_MODE=true

# --- Live backend (uncomment to leave demo mode) --------------------------------------------------
# Base URL of the ASP.NET Core Web API (see backend-database-architecture.md section 5)
# VITE_API_BASE_URL=https://localhost:5001/api

# SignalR hub URL (see backend-database-architecture.md section 5, "SignalR hub")
# VITE_SIGNALR_HUB_URL=https://localhost:5001/hubs/monitoring

# --- UI -----------------------------------------------------------------------------------------
# Default UI language when no saved choice / browser language is available: "ar" | "en"
VITE_DEFAULT_LANGUAGE=ar
